{
  "name": "mpt-cartoon-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "render": "tsx scripts/render.ts",
    "frames": "tsx scripts/render.ts --stills",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run validate"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  },
  "engines": {"node": ">=22"}
}
